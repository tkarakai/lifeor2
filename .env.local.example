# Reference only. `bun run local:setup --from <saved-deployment-directory>`
# generates .env.local with the recovered private admin key.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3240
CONVEX_SELF_HOSTED_ADMIN_KEY=
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3240
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3241
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SITE_URL and BETTER_AUTH_SECRET are configured in the Convex backend
# by `bun run convex:dev`, not by adding them to this frontend env file.

# Git-owned Markdown details. Defaults shown; this is a separate local bare
# content repository, not the application source repository. No remote needed.
# Initialize once: git init --bare --initial-branch=main .convex/details-content.git
DETAILS_REPOSITORY_PATH=.convex/details-content.git
DETAILS_REPOSITORY_KEY=local
DETAILS_GIT_BRANCH=main
# Optional local commit attribution (does not change global Git configuration).
# DETAILS_GIT_AUTHOR_NAME=LifeOR2
# DETAILS_GIT_AUTHOR_EMAIL=lifeor2@localhost

# Optional exact browser-client origins allowed to use bearer-authenticated MCP,
# token and revocation endpoints. Cookie-based consent stays same-origin.
# MCP_ALLOWED_ORIGINS=https://assistant.example.com

# For remote deployments, set NEXT_PUBLIC_SITE_URL and backend SITE_URL to the
# same canonical HTTPS origin (no trailing slash). Configure these SEPARATELY
# in the Convex backend, not as public frontend variables:
# RESEND_API_KEY=<secret>
# AUTH_EMAIL_FROM=LifeOR2 <login@your-verified-domain.example>
